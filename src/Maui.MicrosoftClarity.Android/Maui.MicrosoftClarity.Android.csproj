<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="NugetProperties">
    <Authors>Kebechet</Authors>
    <IsPackable>true</IsPackable>
    <PackageId>Kebechet.Maui.MicrosoftClarity.Android</PackageId>
    <Description>Contains bindings for https://learn.microsoft.com/en-us/clarity/mobile-sdk/android-sdk</Description>
    <RepositoryUrl>https://github.com/Kebechet/Maui.MicrosoftClarity/tree/main/src/Maui.MicrosoftClarity.Android</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Kebechet/Maui.MicrosoftClarity/tree/main/src/Maui.MicrosoftClarity.Android</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>icon.png</PackageIcon>
    <Version>3.9.0.0</Version>
    <PackageReleaseNotes>3.9.0.0: bumped native Clarity Android SDK from 3.8.2 to 3.9.0. Changelog: https://learn.microsoft.com/en-us/clarity/mobile-sdk/sdk-changelog#android-sdk-changelog</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--The AAR is downloaded from Maven Central and its POM drives Java dependency
    verification, so every Clarity bump cross-checks the PackageReference list below.-->
    <AndroidMavenLibrary Include="com.microsoft.clarity:clarity" Version="3.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!--JavaArtifact tells the POM verifier which Maven coordinate these two packages
    fulfill: neither carries the `artifact_versioned=` nuspec tag the verifier reads
    (Xamarin.Android.Binding.InstallReferrer is third-party, Xamarin.Protobuf.JavaLite
    only started emitting the tag in 4.28.0 - a protobuf major bump we don't want).-->
    <PackageReference Include="Xamarin.Android.Binding.InstallReferrer" Version="2.2.0"
                      JavaArtifact="com.android.installreferrer:installreferrer:2.2" />
    <PackageReference Include="Xamarin.Protobuf.JavaLite" Version="3.25.3"
                      JavaArtifact="com.google.protobuf:protobuf-javalite:3.25.3" />
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.0.0" />

    <!--fixed build error "androidx.collection.ArrayMapKt is defined multiple times"-->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.7.0.2" />
  </ItemGroup>
</Project>